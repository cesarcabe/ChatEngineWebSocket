{
  "name": "chatengine-websocket",
  "version": "1.0.0",
  "description": "Mini ChatEngine WebSocket server for Lovable integration",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/**/*.ts",
    "test": "jest",
    "config": "tsx config.ts",
    "docker:build": "docker build -t chatengine-websocket .",
    "docker:run": "docker run -p 3001:3001 --env-file .env chatengine-websocket",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f chatengine-websocket"
  },
  "keywords": [
    "chatengine",
    "websocket",
    "lovable",
    "supabase",
    "evolution",
    "whatsapp"
  ],
  "author": "Whisper Flow CRM Team",
  "license": "MIT",
  "dependencies": {
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "@supabase/supabase-js": "^2.87.1",
    "jose": "^5.10.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "compression": "^1.7.5",
    "winston": "^3.17.0",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/compression": "^1.7.5",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.8.3",
    "tsx": "^4.19.2",
    "eslint": "^9.32.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.14"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
